{
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/api/Cutenv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "terminal.integrated.cwd": "${workspaceFolder}/apps/api",
  "terminal.integrated.profiles.windows": {
    "OmniCut API PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}/apps/api/Cutenv/Scripts/Activate.ps1'"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "OmniCut API PowerShell"
}
